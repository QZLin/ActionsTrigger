# Copy to `.env` (git-ignored) or export the same names in the environment.

# owner/repo that stores the unit state in its Actions variables.
# Inside GitHub Actions the automatic GITHUB_REPOSITORY is used instead.
ACTIONS_TRIGGER_REPO=owner/repo

# Token with read/write access to Actions variables and read access to releases.
# GITHUB_TOKEN / GH_TOKEN are accepted as fallbacks.
ACTIONS_TRIGGER_TOKEN=ghp_xxxxxxxxxxxx

# Optional overrides
# ACTIONS_TRIGGER_CONFIG_DIR=config
# ACTIONS_TRIGGER_CONFIG_SOURCE=release   # release | branch
# ACTIONS_TRIGGER_CONFIG_TAG=store-config # source=release: assets of this release tag
# ACTIONS_TRIGGER_CONFIG_BRANCH=config    # source=branch: branch holding the yaml files
# ACTIONS_TRIGGER_CONFIG_PATH=            # source=branch: directory inside the branch (empty = root)
# ACTIONS_TRIGGER_API_URL=https://api.github.com
# ACTIONS_TRIGGER_DEBUG=1
# ACTIONS_TRIGGER_ENV_FILE=.env
